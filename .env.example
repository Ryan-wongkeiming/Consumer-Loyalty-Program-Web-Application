# ============================================================
# CareHub — environment variables
# ============================================================
# Copy this file to ".env" and fill in YOUR Supabase project values.
# NEVER commit the real .env file (it is git-ignored).

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon public" key (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=