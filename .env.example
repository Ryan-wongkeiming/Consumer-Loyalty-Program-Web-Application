# ============================================================
# CareHub — environment variables
# ============================================================
# Copy this file to ".env" and fill in YOUR Supabase project values.
# NEVER commit the real .env file (it is git-ignored).

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Your Supabase "anon public" key (Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=

# ============================================================
# Delivery Services — enable/disable carriers per contract
# Set to 'true' or 'false'. Default: all enabled.
# ============================================================
VITE_ENABLE_LALAMOVE=true
VITE_ENABLE_VIETTEL_POST=true
VITE_ENABLE_VNPOST=true

# ============================================================
# Zalo integration — set to 'true' after Zalo business accounts
# (OA + developer app + ZNS templates) are approved.
# VITE_ZALO_APP_ID is the public app id from developers.zalo.me.
# The app secret and ZNS access token go in Edge Function secrets.
# ============================================================
VITE_ENABLE_ZALO=false
VITE_ZALO_APP_ID=
